  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-black tracking-tight">Inventory</h1>
      <%= link_to products_path, class: "text-sm text-emerald-400 hover:text-emerald-300 font-semibold transition" do %>
        Manage Products →
      <% end %>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-3 mb-6">
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
        <p class="text-zinc-500 text-xs font-semibold mb-1">Total</p>
        <p class="text-2xl font-black text-emerald-400"><%= @total_products %></p>
      </div>
      <div class="bg-zinc-900 border border-amber-500/30 rounded-2xl p-4">
        <p class="text-zinc-500 text-xs font-semibold mb-1">Low Stock</p>
        <p class="text-2xl font-black text-amber-400"><%= @low_stock_count %></p>
      </div>
      <div class="bg-zinc-900 border border-red-500/30 rounded-2xl p-4">
        <p class="text-zinc-500 text-xs font-semibold mb-1">Out of Stock</p>
        <p class="text-2xl font-black text-red-400"><%= @out_of_stock_count %></p>
      </div>
    </div>

    <!-- Inventory Table -->
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-zinc-800">
              <th class="text-left px-4 py-3 text-xs font-bold text-zinc-500 uppercase tracking-wider">Product</th>
              <th class="text-left px-4 py-3 text-xs font-bold text-zinc-500 uppercase tracking-wider">Category</th>
              <th class="text-right px-4 py-3 text-xs font-bold text-zinc-500 uppercase tracking-wider">Price</th>
              <th class="text-center px-4 py-3 text-xs font-bold text-zinc-500 uppercase tracking-wider">Stock</th>
              <th class="text-right px-4 py-3 text-xs font-bold text-zinc-500 uppercase tracking-wider">Status</th>
              <th class="text-right px-4 py-3 text-xs font-bold text-zinc-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-800">
            <% @products.each do |product| %>
              <tr class="<%= 'bg-amber-500/5' if product.low_stock? %> <%= 'bg-red-500/5' if product.out_of_stock? %>">
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 bg-zinc-800 rounded-lg flex items-center justify-center text-sm overflow-hidden flex-shrink-0">
                      <% if product.image.attached? %>
                        <%= image_tag product.image, class: "w-full h-full object-cover" %>
                      <% else %>
                        <%= product.category == "food" ? "🍕" : "🥤" %>
                      <% end %>
                    </div>
                    <span class="font-semibold truncate"><%= product.name %></span>
                  </div>
                </td>
                <td class="px-4 py-3 text-sm text-zinc-400 capitalize"><%= product.category %></td>
                <td class="px-4 py-3 text-right text-sm font-semibold"><%= format_currency(product.price) %></td>
                <td class="px-4 py-3 text-center">
                  <%= form_with url: set_stock_inventory_path(product), method: :patch, class: "inline-flex items-center gap-1" do |f| %>
                    <%= f.number_field :stock_quantity, value: product.stock_quantity, min: 0, class: "w-16 bg-zinc-800 border border-zinc-700 rounded-lg px-2 py-1.5 text-sm text-center text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50" %>
                    <%= f.submit "Set", class: "px-2 py-1.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-lg text-xs font-bold transition cursor-pointer" %>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <% if product.out_of_stock? %>
                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-500/10 text-red-400 rounded-full text-xs font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                      Out
                    </span>
                  <% elsif product.low_stock? %>
                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-amber-500/10 text-amber-400 rounded-full text-xs font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                      <%= product.stock_quantity %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center gap-1 px-2 py-1 bg-emerald-500/10 text-emerald-400 rounded-full text-xs font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <%= product.stock_quantity %>
                    </span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-1">
                    <%= button_to update_stock_inventory_path(product, adjustment: 10), method: :patch, class: "px-2 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-400 rounded-lg text-xs font-semibold transition", title: "Add 10" do %>
                      +10
                    <% end %>
                    <%= button_to update_stock_inventory_path(product, adjustment: 1), method: :patch, class: "px-2 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-400 rounded-lg text-xs font-semibold transition", title: "Add 1" do %>
                      +1
                    <% end %>
                    <%= link_to edit_product_path(product), class: "px-2 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-400 rounded-lg text-xs font-semibold transition", title: "Edit product" do %>
                      ✏️
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if @products.empty? %>
      <div class="text-center py-20">
        <div class="text-6xl mb-4">📦</div>
        <p class="text-zinc-500 text-lg mb-6">No products yet</p>
        <%= link_to "Add Product", new_product_path, class: "inline-block px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl font-bold transition" %>
      </div>
    <% end %>
  </div>
