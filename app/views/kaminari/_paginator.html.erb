<%# The paginator itself - renders the page navigation. These tag methods are only available inside paginator.render block (instance_eval on the Paginator). -%>
<%= paginator.render do -%>
  <div class="flex items-center justify-center gap-1">
    <%= prev_page_tag unless current_page.first? %>
    <% each_page do |page| -%>
      <% if page.display_tag? -%>
        <%= page_tag page %>
      <% elsif !page.was_truncated? -%>
        <%= gap_tag %>
      <% end -%>
    <% end -%>
    <%= next_page_tag unless current_page.last? %>
  </div>
<% end -%>
