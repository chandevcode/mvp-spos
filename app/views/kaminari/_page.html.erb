<% if page.current? %>
  <span class="w-10 h-10 bg-emerald-500 text-zinc-950 rounded-xl flex items-center justify-center text-sm font-bold"><%= page %></span>
<% else %>
  <%= link_to page, url, class: "w-10 h-10 bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-zinc-50 rounded-xl flex items-center justify-center text-sm font-semibold transition-all" %>
<% end %>
