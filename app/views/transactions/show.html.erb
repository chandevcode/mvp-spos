<div class="max-w-md mx-auto bg-white text-zinc-950 p-8 rounded-lg shadow-xl print:shadow-none print:p-0" id="receipt">
  <div class="text-center border-b-2 border-dashed border-zinc-200 pb-6 mb-6">
    <h1 class="text-2xl font-black uppercase tracking-widest">SPOS RECEIPT</h1>
    <p class="text-zinc-500 text-sm mt-1"><%= @transaction.created_at.strftime("%B %d, %Y %H:%M") %></p>
    <p class="text-zinc-500 text-xs mt-1">Order #<%= @transaction.id %></p>
  </div>

  <div class="space-y-4 mb-6">
    <% @transaction.transaction_items.each do |item| %>
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <p class="font-bold"><%= item.product.name %></p>
          <p class="text-zinc-500 text-sm"><%= item.quantity %> x <%= format_currency(item.price) %></p>
        </div>
        <p class="font-bold"><%= format_currency(item.price * item.quantity) %></p>
      </div>
    <% end %>
  </div>

  <div class="border-t-2 border-dashed border-zinc-200 pt-6 space-y-2">
    <div class="flex justify-between text-lg">
      <span class="text-zinc-500">Subtotal</span>
      <span><%= format_currency(@transaction.total_price) %></span>
    </div>
    <div class="flex justify-between text-2xl font-black pt-2 border-t border-zinc-100">
      <span>TOTAL</span>
      <span><%= format_currency(@transaction.total_price) %></span>
    </div>
  </div>

  <div class="mt-10 text-center text-zinc-400 text-sm italic">
    <p>Thank you for your business!</p>
    <p>Please come again</p>
  </div>
</div>

<div class="max-w-md mx-auto mt-8 flex gap-4 print:hidden">
  <button onclick="window.print()" class="flex-1 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 py-4 rounded-xl font-black text-lg transition-all active:scale-95 flex items-center justify-center gap-2">
    <span>🖨️</span> Print Receipt
  </button>
  <%= link_to root_path, class: "flex-1 bg-zinc-800 hover:bg-zinc-700 text-white py-4 rounded-xl font-bold text-center transition" do %>
    Back to Home
  <% end %>
</div>

<style type="text/css">
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    nav, footer, .print-hidden {
      display: none !important;
    }
    #receipt {
      width: 80mm; /* Standard thermal printer width */
      margin: 0 auto;
      box-shadow: none;
      padding: 0;
    }
  }
</style>
