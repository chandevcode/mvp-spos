<div class="min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-md text-center">
      <div class="bg-zinc-900 border border-emerald-500/30 rounded-3xl p-8 md:p-12">
        <div class="text-6xl mb-6">🎉</div>
        <h1 class="text-3xl font-black mb-3">Payment Successful!</h1>
        <p class="text-zinc-400 mb-2">Your SPOS account has been created.</p>
        <p class="text-zinc-500 text-sm mb-8">
          A confirmation email has been sent to <span class="text-zinc-300 font-semibold"><%= @email %></span>
        </p>

        <div class="bg-emerald-500/10 rounded-xl p-4 mb-8">
          <p class="text-emerald-400 text-sm font-semibold">
            🚀 You can now sign in and start managing your business!
          </p>
        </div>

        <%= link_to "Sign In", new_user_session_path, class: "inline-block w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 py-3 rounded-xl font-bold transition-all active:scale-95" %>
      </div>

      <div class="mt-6">
        <p class="text-zinc-500 text-sm">
          <%= link_to "Back to Home", root_path, class: "text-zinc-400 hover:text-zinc-300 font-semibold transition" %>
        </p>
      </div>
    </div>
  </div>
