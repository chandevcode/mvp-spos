<div class="min-h-screen flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-md">
      <div class="text-center mb-6 sm:mb-8">
        <%= link_to register_path, class: "inline-block" do %>
          <h1 class="text-4xl sm:text-5xl font-black tracking-tighter text-emerald-400 mb-2">SPOS</h1>
        <% end %>
        <p class="text-zinc-400 font-semibold">
          <%= @plan_type == "monthly" ? "📆 Monthly" : "🌟 Annual" %> Plan
          <span class="text-emerald-400">• Rp <%= @plan_type == "monthly" ? "150.000" : "1.500.000" %></span>
        </p>
        <%= link_to "Change plan", register_path, class: "text-xs text-zinc-500 hover:text-zinc-400 transition mt-1 inline-block" %>
      </div>

      <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8">
        <%= form_with url: register_path, method: :post, class: "space-y-5", local: true,
              data: {
                controller: "form-validator",
                action: "submit->form-validator#validateAll"
              } do |f| %>
          <%= hidden_field_tag :plan_type, @plan_type %>

          <div data-form-validator-target="group">
            <%= label_tag :tenant_name, "Restaurant / Business Name", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= text_field_tag :tenant_name, params[:tenant_name], autofocus: true, placeholder: "Warung Makan Sederhana",
                  data: { form_validator_target: "input", validate: "required", action: "blur->form-validator#validate" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
          </div>

          <div data-form-validator-target="group">
            <%= label_tag :name, "Owner Name", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= text_field_tag :name, params[:name], placeholder: "John Doe",
                  data: { form_validator_target: "input", validate: "required", action: "blur->form-validator#validate" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
          </div>

          <div data-form-validator-target="group">
            <%= label_tag :address, "Address", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= text_area_tag :address, params[:address], placeholder: "Jl. Merdeka No. 123, Jakarta", rows: 2,
                  data: { form_validator_target: "input", action: "blur->form-validator#validate" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition resize-none" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
          </div>

          <div data-form-validator-target="group">
            <%= label_tag :phone_number, "Phone Number", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= telephone_field_tag :phone_number, params[:phone_number], placeholder: "+62 812-3456-7890",
                  data: { form_validator_target: "input", validate: "phone", action: "blur->form-validator#validate" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
          </div>

          <div data-form-validator-target="group">
            <%= label_tag :email, "Email", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= email_field_tag :email, params[:email], autocomplete: "email", placeholder: "you@example.com",
                  data: { form_validator_target: "input", validate: "required", action: "blur->form-validator#checkEmail" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 placeholder-zinc-600 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
          </div>

          <div data-form-validator-target="group">
            <%= label_tag :password, "Password", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= password_field_tag :password, nil, autocomplete: "new-password",
                  data: { form_validator_target: "input", validate: "required min6", action: "blur->form-validator#validate" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
            <p class="text-xs text-zinc-500 mt-1">Minimum 6 characters</p>
          </div>

          <div data-form-validator-target="group">
            <%= label_tag :password_confirmation, "Confirm Password", class: "block text-sm font-bold text-zinc-400 mb-2" %>
            <%= password_field_tag :password_confirmation, nil, autocomplete: "new-password",
                  data: { form_validator_target: "input", action: "blur->form-validator#checkPasswordMatch" },
                  class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
            <p data-form-validator-target="message" class="text-xs mt-1 hidden"></p>
          </div>

          <div class="pt-2">
            <%= f.submit "Continue to Payment", class: "w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 py-3 rounded-xl font-bold transition-all active:scale-95 cursor-pointer" %>
          </div>

          <p class="text-xs text-zinc-500 text-center pt-2">
            By continuing, you agree to our Terms of Service and Privacy Policy.
            Payment will be processed securely via Midtrans.
          </p>
        <% end %>
      </div>

      <div class="text-center mt-6">
        <p class="text-zinc-500 text-sm">
          Already have an account?
          <%= link_to "Sign in", new_user_session_path, class: "text-emerald-400 hover:text-emerald-300 font-semibold transition" %>
        </p>
      </div>
    </div>
  </div>
