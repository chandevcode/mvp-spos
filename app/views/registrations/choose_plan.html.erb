<div class="min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-2xl">
      <div class="text-center mb-10">
        <%= link_to root_path, class: "inline-block" do %>
          <h1 class="text-6xl font-black tracking-tighter text-emerald-400 mb-3">SPOS</h1>
        <% end %>
        <p class="text-zinc-400 text-lg font-semibold">Choose your subscription plan to get started</p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <!-- Monthly Plan -->
        <%= link_to register_plan_path("monthly"), class: "group block relative" do %>
          <div class="bg-zinc-900 border-2 border-zinc-800 rounded-3xl p-6 md:p-8 hover:border-emerald-500/50 transition-all duration-300 h-full flex flex-col">
            <div class="flex-1">
              <div class="text-4xl mb-4">📆</div>
              <h2 class="text-2xl font-black mb-2">Monthly</h2>
              <p class="text-zinc-400 text-sm mb-6">Perfect for trying out SPOS. Billed monthly.</p>
              <div class="mb-6">
                <span class="text-4xl font-black text-emerald-400">Rp 100.000</span>
                <span class="text-zinc-500 text-sm">/month</span>
              </div>
              <ul class="space-y-3 mb-8">
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Full POS system access
                </li>
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Product & inventory management
                </li>
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Sales dashboard & reports
                </li>
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Cancel anytime
                </li>
              </ul>
            </div>
            <div class="bg-emerald-500 group-hover:bg-emerald-400 text-zinc-950 text-center py-3 rounded-xl font-bold transition-all group-active:scale-95">
              Choose Monthly
            </div>
          </div>
        <% end %>

        <!-- Annual Plan -->
        <%= link_to register_plan_path("annual"), class: "group block relative" do %>
          <div class="bg-zinc-900 border-2 border-emerald-500/30 rounded-3xl p-6 md:p-8 hover:border-emerald-500 transition-all duration-300 h-full flex flex-col relative overflow-hidden">
            <div class="absolute top-4 right-4 bg-emerald-500 text-zinc-950 text-xs font-bold px-3 py-1 rounded-full">
              BEST VALUE
            </div>
            <div class="flex-1">
              <div class="text-4xl mb-4">🌟</div>
              <h2 class="text-2xl font-black mb-2">Annual</h2>
              <p class="text-zinc-400 text-sm mb-6">Best value for serious businesses. Save 2 months!</p>
              <div class="mb-6">
                <span class="text-4xl font-black text-emerald-400">Rp 1.000.000</span>
                <span class="text-zinc-500 text-sm">/year</span>
              </div>
              <div class="bg-emerald-500/10 rounded-xl p-3 mb-6">
                <p class="text-emerald-400 text-sm font-semibold text-center">
                  Save Rp 200.000 compared to monthly
                </p>
              </div>
              <ul class="space-y-3 mb-8">
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Everything in Monthly, plus:
                </li>
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  2 months free
                </li>
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Priority support
                </li>
                <li class="flex items-start gap-3 text-sm text-zinc-300">
                  <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  Best price guaranteed
                </li>
              </ul>
            </div>
            <div class="bg-emerald-500 group-hover:bg-emerald-400 text-zinc-950 text-center py-3 rounded-xl font-bold transition-all group-active:scale-95">
              Choose Annual
            </div>
          </div>
        <% end %>
      </div>

      <div class="text-center mt-8">
        <p class="text-zinc-500 text-sm">
          Already have an account?
          <%= link_to "Sign in", new_user_session_path, class: "text-emerald-400 hover:text-emerald-300 font-semibold transition" %>
        </p>
      </div>
    </div>
  </div>
