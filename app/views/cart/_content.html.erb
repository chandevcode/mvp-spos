<% if cart.any? %>
  <div class="space-y-3 mb-6">
    <% cart.each do |product_id, quantity| %>
      <% product = Product.find_by(id: product_id) %>
      <% next unless product %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex items-center gap-4">
        <div class="w-16 h-16 bg-gradient-to-br from-emerald-500/20 to-zinc-800 rounded-xl flex items-center justify-center text-2xl flex-shrink-0 overflow-hidden">
          <% if product.image.attached? %>
            <%= image_tag product.image, class: "w-full h-full object-cover" %>
          <% else %>
            <%= product.category == "food" ? "🍕" : "🥤" %>
          <% end %>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-bold text-lg truncate"><%= product.name %></h3>
          <p class="text-emerald-400 font-black text-lg"><%= format_currency(product.price) %></p>
        </div>
        <div class="flex items-center gap-3">
          <%= button_to remove_from_cart_path(product), method: :post, data: { turbo_frame: "cart-content" }, class: "w-8 h-8 bg-zinc-800 hover:bg-zinc-700 rounded-lg flex items-center justify-center font-bold transition" do %>
            −
          <% end %>
          <span class="font-bold text-lg w-8 text-center"><%= quantity %></span>
          <%= button_to add_to_cart_path(product), method: :post, data: { turbo_frame: "cart-content" }, class: "w-8 h-8 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-lg flex items-center justify-center font-bold transition" do %>
            +
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 space-y-4">
    <div class="flex items-center justify-between text-lg">
      <span class="text-zinc-400">Subtotal</span>
      <span class="font-bold"><%= format_currency(cart_total) %></span>
    </div>
    <div class="flex items-center justify-between text-2xl border-t border-zinc-800 pt-4">
      <span class="font-black">Total</span>
      <span class="font-black text-emerald-400"><%= format_currency(cart_total) %></span>
    </div>

    <div class="pt-4 space-y-2">
      <%= button_to "Save", checkout_path, method: :post, data: { turbo_frame: "_top" }, class: "w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 py-3 rounded-xl font-bold text-sm transition-all active:scale-95" %>
      <%= button_to "Print", checkout_path(print: true), method: :post, data: { turbo_frame: "_top" }, class: "w-full bg-zinc-800 hover:bg-zinc-700 text-white py-3 rounded-xl font-bold text-sm transition-all active:scale-95 border border-zinc-700" %>
      <%= button_to clear_cart_path, method: :delete, data: { turbo_confirm: "Clear all items?" }, class: "w-full py-2.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-1.5" do %>
        <span>🗑️</span> Clear
      <% end %>
    </div>
  </div>
<% else %>
  <div class="text-center py-20">
    <div class="text-6xl mb-4">🛒</div>
    <p class="text-zinc-500 text-lg mb-6">Your cart is empty</p>
    <%= link_to "Start Shopping", root_path, class: "inline-block px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl font-bold transition" %>
  </div>
<% end %>
