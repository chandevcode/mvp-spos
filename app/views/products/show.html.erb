<div class="w-full max-w-2xl mx-auto px-4 sm:px-0">
  <%= link_to products_path, class: "inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-50 mb-4 sm:mb-6 transition text-sm sm:text-base" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
    </svg>
    Back
  <% end %>

  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl sm:rounded-3xl overflow-hidden">
    <!-- Image Section - Responsive aspect ratio -->
    <div class="relative aspect-[4/3] sm:aspect-video bg-gradient-to-br from-emerald-500/20 to-zinc-900 flex items-center justify-center overflow-hidden">
      <% if @product.image.attached? %>
        <%= image_tag @product.image, class: "w-full h-full object-cover" %>
      <% else %>
        <div class="text-5xl sm:text-7xl md:text-8xl transition-all"><%= @product.category == "food" ? "🍕" : "🥤" %></div>
      <% end %>
      
      <!-- Category badge overlay on mobile -->
      <span class="absolute top-4 right-4 sm:hidden text-xs px-3 py-1.5 bg-zinc-900/90 backdrop-blur-sm text-zinc-300 rounded-full border border-zinc-700/50">
        <%= @product.category %>
      </span>
    </div>
    
    <div class="p-4 sm:p-6 space-y-4 sm:space-y-5">
      <!-- Header Section -->
      <div class="space-y-2 sm:space-y-0">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight leading-tight">
            <%= @product.name %>
          </h1>
          <!-- Category badge - hidden on mobile (shown on image), visible on desktop -->
          <span class="hidden sm:inline-block text-xs px-3 py-1 bg-zinc-800 text-zinc-400 rounded-full whitespace-nowrap">
            <%= @product.category %>
          </span>
        </div>
        <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
          <%= @product.description %>
        </p>
      </div>

      <!-- Price & Actions Section -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-4 border-t border-zinc-800">
        <span class="text-3xl sm:text-4xl font-black text-emerald-400">
          <%= format_currency(@product.price) %>
        </span>
        
        <!-- Action Buttons -->
        <div class="flex gap-2 w-full sm:w-auto">
          <%= link_to edit_product_path(@product), 
              class: "flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-50 rounded-xl font-bold text-sm sm:text-base transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            <span class="sm:inline">Edit</span>
          <% end %>
          
          <%= button_to product_path(@product), 
              method: :delete, 
              data: { turbo_confirm: "Delete this product?" },
              class: "flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl font-bold text-sm sm:text-base transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            <span class="sm:inline">Delete</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
