<div class="max-w-2xl mx-auto">
  <%= link_to products_path, class: "inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-50 mb-6 transition" do %>
    <span>←</span> Back
  <% end %>

  <div class="bg-zinc-900 border border-zinc-800 rounded-3xl overflow-hidden">
    <div class="aspect-video bg-gradient-to-br from-emerald-500/20 to-zinc-900 flex items-center justify-center">
      <div class="text-8xl"><%= @product.category == "food" ? "🍕" : "🥤" %></div>
    </div>
    
    <div class="p-6 space-y-4">
      <div>
        <div class="flex items-start justify-between mb-2">
          <h1 class="text-3xl font-black tracking-tight"><%= @product.name %></h1>
          <span class="text-xs px-3 py-1 bg-zinc-800 text-zinc-400 rounded-full"><%= @product.category %></span>
        </div>
        <p class="text-zinc-400"><%= @product.description %></p>
      </div>

      <div class="flex items-center justify-between pt-4 border-t border-zinc-800">
        <span class="text-4xl font-black text-emerald-400"><%= format_currency(@product.price) %></span>
        <div class="flex gap-2">
          <%= link_to edit_product_path(@product), class: "px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-50 rounded-xl font-bold transition" do %>
            Edit
          <% end %>
          <%= button_to product_path(@product), method: :delete, data: { turbo_confirm: "Delete this product?" }, class: "px-5 py-2.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl font-bold transition" do %>
            Delete
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
