<div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4">
  <h3 class="font-bold text-lg mb-2"><%= product.name %></h3>
  <p class="text-sm text-zinc-400 mb-3"><%= product.description %></p>
  <div class="flex items-center justify-between">
    <span class="text-emerald-400 font-black text-xl"><%= format_currency(product.price) %></span>
    <span class="text-xs px-2 py-1 bg-zinc-800 text-zinc-400 rounded-full"><%= product.category %></span>
  </div>
</div>
