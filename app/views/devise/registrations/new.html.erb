<div class="min-h-[80vh] flex items-center justify-center">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <h1 class="text-5xl font-black tracking-tighter text-emerald-400 mb-2">SPOS</h1>
      <p class="text-zinc-500 font-semibold">Create your account</p>
    </div>

    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, class: "block text-sm font-bold text-zinc-400 mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-bold text-zinc-400 mb-2" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-zinc-500 mt-1"><%= @minimum_password_length %> characters minimum</p>
          <% end %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-bold text-zinc-400 mb-2" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
        </div>

        <div class="pt-2">
          <%= f.submit "Sign up", class: "w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 py-3 rounded-xl font-bold transition-all active:scale-95 cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 pt-6 border-t border-zinc-800 text-center space-y-2">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
