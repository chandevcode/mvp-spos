<div class="text-sm space-y-2">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Sign in", new_session_path(resource_name), class: "text-emerald-400 hover:text-emerald-300 font-semibold transition" %>
  <% end %>

  <%- if controller_name != 'registrations' %>
    <%= link_to "Sign up", register_path, class: "text-emerald-400 hover:text-emerald-300 font-semibold transition" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-zinc-500 hover:text-zinc-400 transition" %>
  <% end %>
</div>
