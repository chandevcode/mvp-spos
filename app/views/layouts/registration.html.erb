<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SPOS - Register" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SPOS">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-zinc-950 text-zinc-50 min-h-screen">
    <% if notice || alert %>
      <div data-controller="flash" class="fixed top-4 left-0 right-0 px-4 z-40 md:left-auto md:right-4 md:w-96">
        <% if notice %>
          <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-4 mb-2 backdrop-blur-xl shadow-lg shadow-emerald-500/5">
            <p class="text-emerald-400 text-sm font-semibold"><%= notice %></p>
          </div>
        <% end %>
        <% if alert %>
          <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 backdrop-blur-xl shadow-lg shadow-red-500/5">
            <p class="text-red-400 text-sm font-semibold"><%= alert %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <main class="min-h-screen">
      <%= yield %>
    </main>
  </body>
</html>
