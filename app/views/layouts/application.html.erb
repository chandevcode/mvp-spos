<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Spos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Spos">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://www.gstatic.com/charts/loader.js"></script>
    <script src="https://unpkg.com/chartkick@5.0.1/dist/chartkick.js"></script>
  </head>

  <body class="bg-zinc-950 text-zinc-50 min-h-screen">
    <nav class="fixed top-0 left-0 right-0 z-50 bg-zinc-900/80 backdrop-blur-xl border-b border-zinc-800">
      <div class="px-4 py-3 flex items-center justify-between">
        <%= link_to root_path, class: "text-2xl font-black tracking-tighter text-emerald-400" do %>
          SPOS
        <% end %>
        
        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-3">
          <% if user_signed_in? %>
            <% if current_user.admin? || current_user.owner? %>
              <%= link_to "Products", products_path, class: "text-sm font-semibold text-zinc-400 hover:text-zinc-50 transition" %>
              <%= link_to "Inventory", inventory_index_path, class: "text-sm font-semibold text-zinc-400 hover:text-zinc-50 transition" %>
            <% end %>
            <% if current_user.owner? %>
              <%= link_to "Dashboard", dashboard_path, class: "text-sm font-semibold text-zinc-400 hover:text-zinc-50 transition" %>
              <%= link_to "Users", users_path, class: "text-sm font-semibold text-zinc-400 hover:text-zinc-50 transition" %>
            <% end %>
            <%= link_to "Profile", edit_profile_path, class: "text-sm font-semibold text-zinc-400 hover:text-zinc-50 transition" %>
            <%= link_to "Logout", 
              destroy_user_session_path, 
              data: {turbo_method: :delete},
              class: "w-full text-left px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>


          <% else %>
            <%= link_to "Register", register_path, class: "text-sm font-semibold text-zinc-400 hover:text-zinc-50 transition" %>
            <%= link_to "Login", new_user_session_path, class: "text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition" %>
          <% end %>
        </div>

        <!-- Mobile Menu Button -->
        <button onclick="toggleMenu()" class="md:hidden w-10 h-10 flex items-center justify-center text-zinc-400 hover:text-zinc-50 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div id="mobileMenu" class="hidden md:hidden border-t border-zinc-800 bg-zinc-900">
        <div class="px-4 py-3 space-y-2">
          <% if user_signed_in? %>
            <% if current_user.admin? || current_user.owner? %>
              <%= link_to "Products", products_path, class: "block px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
              <%= link_to "Inventory", inventory_index_path, class: "block px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
            <% end %>
            <% if current_user.owner? %>
              <%= link_to "Dashboard", dashboard_path, class: "block px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
              <%= link_to "Users", users_path, class: "block px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
            <% end %>
            <%= link_to "Profile", edit_profile_path, class: "block px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
            <%= link_to "Logout", 
              destroy_user_session_path, 
              data: {turbo_method: :delete},
              class: "w-full text-left px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
          <% else %>
            <%= link_to "Register", register_path, class: "block px-4 py-2 text-sm font-semibold text-zinc-400 hover:text-zinc-50 hover:bg-zinc-800 rounded-lg transition" %>
            <%= link_to "Login", new_user_session_path, class: "block px-4 py-2 text-sm font-semibold text-emerald-400 hover:text-emerald-300 hover:bg-zinc-800 rounded-lg transition" %>
          <% end %>
        </div>
      </div>
    </nav>

    <script>
      function toggleMenu() {
        const menu = document.getElementById('mobileMenu');
        menu.classList.toggle('hidden');
      }
    </script>

    <% if notice || alert %>
      <div data-controller="flash" class="fixed top-16 left-0 right-0 px-4 z-40 animate-in slide-in-from-top duration-300 md:left-auto md:right-4 md:w-96">
        <% if notice %>
          <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-4 mb-2 backdrop-blur-xl shadow-lg shadow-emerald-500/5">
            <p class="text-emerald-400 text-sm font-semibold"><%= notice %></p>
          </div>
        <% end %>
        <% if alert %>
          <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 backdrop-blur-xl shadow-lg shadow-red-500/5">
            <p class="text-red-400 text-sm font-semibold"><%= alert %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Subscription Expired Banner -->
    <% if flash[:subscription_expired] %>
      <div class="bg-red-500/10 border-b border-red-500/20 px-4 py-3">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="text-xl">⚠️</span>
            <div>
              <p class="text-red-400 text-sm font-bold">Your subscription has expired</p>
              <p class="text-red-400/70 text-xs">Extend your subscription to continue using all SPOS features.</p>
            </div>
          </div>
          <%= link_to "Extend Now", extend_subscription_path, class: "shrink-0 bg-red-500 hover:bg-red-400 text-white px-4 py-1.5 rounded-lg text-sm font-bold transition-all active:scale-95" %>
        </div>
      </div>
    <% end %>

    <!-- Subscription Expiring Soon Banner -->
    <% if flash[:subscription_expiring] %>
      <% days_left = flash[:subscription_expiring] %>
      <div class="bg-amber-500/10 border-b border-amber-500/20 px-4 py-3">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="text-xl">⏳</span>
            <div>
              <p class="text-amber-400 text-sm font-bold">
                Your subscription expires in <%= days_left %> <%= days_left == 1 ? 'day' : 'days' %>
              </p>
              <p class="text-amber-400/70 text-xs">Extend now to avoid interruption.</p>
            </div>
          </div>
          <%= link_to "Extend Now", extend_subscription_path, class: "shrink-0 bg-amber-500 hover:bg-amber-400 text-zinc-950 px-4 py-1.5 rounded-lg text-sm font-bold transition-all active:scale-95" %>
        </div>
      </div>
    <% end %>

    <main class="pt-20 pb-24 px-4">
      <%= yield %>
    </main>
  </body>
</html>
