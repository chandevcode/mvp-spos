<div class="max-w-2xl mx-auto">
  <%= link_to users_path, class: "inline-flex items-center gap-2 text-zinc-400 hover:text-zinc-50 mb-6 transition" do %>
    <span>←</span> Back
  <% end %>

  <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-6">
    <h1 class="text-3xl font-black tracking-tight mb-6">Add User</h1>
    
    <%= form_with model: @user, url: users_path, class: "space-y-4" do |f| %>
      <% if @user.errors.any? %>
        <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4">
          <h2 class="text-red-400 font-bold mb-2"><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
          <ul class="list-disc list-inside text-red-400 text-sm space-y-1">
            <% @user.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-bold text-zinc-400 mb-2" %>
        <%= f.text_field :name, class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition", placeholder: "Full name" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-bold text-zinc-400 mb-2" %>
        <%= f.email_field :email, autofocus: true, class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
      </div>

      <div>
        <%= f.hidden_field :role, value: "admin" %>
      </div>
      <div>
        <%= f.label :password, class: "block text-sm font-bold text-zinc-400 mb-2" %>
        <%= f.password_field :password, class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
        <p class="text-xs text-zinc-500 mt-1">Minimum 6 characters</p>
      </div>

      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-bold text-zinc-400 mb-2" %>
        <%= f.password_field :password_confirmation, class: "w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
      </div>

      <div class="flex gap-3 pt-4">
        <%= f.submit "Create User", class: "flex-1 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 py-3 rounded-xl font-bold transition-all active:scale-95 cursor-pointer" %>
        <%= link_to "Cancel", users_path, class: "flex-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-50 py-3 rounded-xl font-bold text-center transition" %>
      </div>
    <% end %>
  </div>
</div>
