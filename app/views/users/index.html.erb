<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-black tracking-tight">Users</h1>
    <% if User.admin.count < 2 %>
      <%= link_to new_user_path, class: "bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-5 py-2.5 rounded-xl font-bold transition-all active:scale-95" do %>
        + Add User
      <% end %>
    <% end %>
  </div>

  <!-- Admin slot indicator -->
  <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 mb-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-bold">Staff / Admin Slots</p>
        <p class="text-xs text-zinc-500">Maximum 2 staff/admin users per tenant</p>
      </div>
      <div class="text-right">
        <p class="text-2xl font-black <%= User.admin.count >= 2 ? 'text-red-400' : 'text-emerald-400' %>"><%= User.admin.count %> / 2</p>
      </div>
    </div>
    <div class="mt-3 w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
      <div class="h-full rounded-full transition-all duration-300 <%= User.admin.count >= 2 ? 'bg-red-500' : 'bg-emerald-500' %>" style="width: <%= [User.admin.count.to_f / 2 * 100, 100].min %>%"></div>
    </div>
  </div>

  <div class="space-y-3">
    <% @users.each do |user| %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <p class="font-bold text-lg"><%= user.name.present? ? user.name : user.email %></p>
            <span class="text-xs px-2 py-0.5 rounded-full font-semibold <%= user.owner? ? 'bg-purple-500/20 text-purple-400' : 'bg-emerald-500/20 text-emerald-400' %>"><%= user.role %></span>
          </div>
          <p class="text-sm text-zinc-400"><%= user.email %></p>
          <p class="text-sm text-zinc-500">Created <%= user.created_at.strftime("%b %d, %Y") %></p>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to edit_user_path(user), class: "w-10 h-10 bg-zinc-800 hover:bg-zinc-700 rounded-xl flex items-center justify-center transition" do %>
            <span class="text-lg">✏️</span>
          <% end %>
          <% unless user == current_user || user.owner? %>
            <%= button_to user_path(user), method: :delete, data: { turbo_confirm: "Delete this user?" }, class: "w-10 h-10 bg-red-500/10 hover:bg-red-500/20 rounded-xl flex items-center justify-center transition" do %>
              <span class="text-lg">🗑️</span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @users.empty? %>
      <div class="text-center py-20">
        <p class="text-zinc-500 text-lg mb-4">No users yet</p>
        <%= link_to "Add First User", new_user_path, class: "inline-block px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl font-bold transition" %>
      </div>
    <% end %>
  </div>
</div>
