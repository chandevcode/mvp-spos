<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-black tracking-tight">Users</h1>
    <%= link_to new_user_path, class: "bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-5 py-2.5 rounded-xl font-bold transition-all active:scale-95" do %>
      + Add User
    <% end %>
  </div>

  <div class="space-y-3">
    <% @users.each do |user| %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <p class="font-bold text-lg"><%= user.email %></p>
            <span class="text-xs px-2 py-0.5 rounded-full font-semibold <%= user.owner? ? 'bg-purple-500/20 text-purple-400' : 'bg-emerald-500/20 text-emerald-400' %>"><%= user.role %></span>
          </div>
          <p class="text-sm text-zinc-500">Created <%= user.created_at.strftime("%b %d, %Y") %></p>
        </div>
        <% unless user == current_user %>
          <%= button_to user_path(user), method: :delete, data: { turbo_confirm: "Delete this user?" }, class: "w-10 h-10 bg-red-500/10 hover:bg-red-500/20 rounded-xl flex items-center justify-center transition" do %>
            <span class="text-lg">🗑️</span>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if @users.empty? %>
      <div class="text-center py-20">
        <p class="text-zinc-500 text-lg mb-4">No users yet</p>
        <%= link_to "Add First User", new_user_path, class: "inline-block px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl font-bold transition" %>
      </div>
    <% end %>
  </div>
</div>
