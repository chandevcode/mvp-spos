<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-black tracking-tight">Admin Users</h1>
    <% if @users.count < 3 %>
      <%= link_to new_user_path, class: "bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-5 py-2.5 rounded-xl font-bold transition-all active:scale-95" do %>
        + Add Admin
      <% end %>
    <% end %>
  </div>

  <% if @users.count >= 3 %>
    <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 mb-6">
      <p class="text-amber-400 text-sm font-semibold">⚠️ Maximum limit reached (3 admin users)</p>
    </div>
  <% end %>

  <div class="space-y-3">
    <% @users.each do |user| %>
      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-4 flex items-center justify-between">
        <div>
          <p class="font-bold text-lg"><%= user.email %></p>
          <p class="text-sm text-zinc-500">Created <%= user.created_at.strftime("%b %d, %Y") %></p>
        </div>
        <%= button_to user_path(user), method: :delete, data: { turbo_confirm: "Delete this admin user?" }, class: "w-10 h-10 bg-red-500/10 hover:bg-red-500/20 rounded-xl flex items-center justify-center transition" do %>
          <span class="text-lg">🗑️</span>
        <% end %>
      </div>
    <% end %>

    <% if @users.empty? %>
      <div class="text-center py-20">
        <p class="text-zinc-500 text-lg mb-4">No admin users yet</p>
        <%= link_to "Add First Admin", new_user_path, class: "inline-block px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl font-bold transition" %>
      </div>
    <% end %>
  </div>
</div>
