<div class="max-w-7xl mx-auto">
  <!-- Search & Filters -->
  <%= form_with url: root_path, method: :get, class: "mb-6 space-y-3" do |f| %>
    <%= f.text_field :search, placeholder: "Search products...", value: params[:search], class: "w-full bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-50 placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition" %>
    
    <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
      <%= link_to "All", root_path, class: "px-5 py-2 #{params[:category].blank? ? 'bg-emerald-500 text-zinc-950' : 'bg-zinc-900 text-zinc-400 hover:bg-zinc-800'} rounded-full text-sm font-semibold whitespace-nowrap transition" %>
      <%= link_to "Food", root_path(category: 'food'), class: "px-5 py-2 #{params[:category] == 'food' ? 'bg-emerald-500 text-zinc-950' : 'bg-zinc-900 text-zinc-400 hover:bg-zinc-800'} rounded-full text-sm font-semibold whitespace-nowrap transition" %>
      <%= link_to "Beverage", root_path(category: 'beverage'), class: "px-5 py-2 #{params[:category] == 'beverage' ? 'bg-emerald-500 text-zinc-950' : 'bg-zinc-900 text-zinc-400 hover:bg-zinc-800'} rounded-full text-sm font-semibold whitespace-nowrap transition" %>
    </div>
  <% end %>

  <!-- Products Grid -->
  <% if @products.any? %>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
      <% @products.each do |product| %>
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden group hover:border-emerald-500/50 transition-all duration-300">
          <div class="aspect-square bg-gradient-to-br from-emerald-500/20 to-zinc-900 flex items-center justify-center">
            <div class="text-4xl"><%= product.category == "food" ? "🍕" : "🥤" %></div>
          </div>
          <div class="p-3">
            <h3 class="font-bold text-sm mb-1 truncate"><%= product.name %></h3>
            <p class="text-xs text-zinc-500 mb-2 truncate"><%= product.description %></p>
            <div class="flex items-center justify-between">
              <span class="text-emerald-400 font-black text-lg">$<%= product.price %></span>
              <%= button_to add_to_cart_path(product), method: :post, class: "bg-emerald-500 hover:bg-emerald-400 text-zinc-950 w-8 h-8 rounded-full flex items-center justify-center font-bold transition-all active:scale-95" do %>
                +
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20">
      <p class="text-zinc-500 text-lg">No products found</p>
      <% if user_signed_in? %>
        <%= link_to "Add Product", new_product_path, class: "inline-block mt-4 px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 rounded-xl font-bold transition" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Floating Cart Button -->
<% if cart_count > 0 %>
  <%= link_to cart_path, class: "fixed bottom-6 right-6 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 px-6 py-4 rounded-full shadow-2xl shadow-emerald-500/50 flex items-center gap-3 font-black text-lg transition-all active:scale-95 z-40" do %>
    <span>🛒</span>
    <span>$<%= number_with_precision(cart_total, precision: 2) %></span>
    <span class="bg-zinc-950 text-emerald-400 w-6 h-6 rounded-full flex items-center justify-center text-sm"><%= cart_count %></span>
  <% end %>
<% end %>
